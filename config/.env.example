# Copie para .env na raiz. Nunca envie este arquivo preenchido ao Git.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Gere as duas chaves independentes: python scripts/generate_keys.py
DATA_ENCRYPTION_KEY=
BLIND_INDEX_SECRET=

# Desenvolvimento local. Em produção: true + origens HTTPS explícitas.
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# A interface usa a mesma origem (/api); o Vite encaminha à API local.
# VITE_API_URL fica vazio. Se necessário, informe só a origem, sem /api.
